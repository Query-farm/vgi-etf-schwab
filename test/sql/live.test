# name: test/sql/live.test
# description: live invariants against Schwab (through the impersonation transport). Asserts shape, not exact (moving) values.
# group: [sql]
#
# Gated: set VGI_SCHWAB_LIVE=1 to run (make test-live, or CI's scheduled/manual live job).
# Schwab's bot protection rate-limits repeated fetches, so this stays out of the default gate.

require-env VGI_TEST_WORKER

require-env VGI_SCHWAB_LIVE

statement ok
ATTACH 'schwab' AS sch (TYPE vgi, LOCATION '{VGI_TEST_WORKER}');

statement ok
SET search_path='sch.main';

# ---- products ----

# The catalog has the Schwab ETF lineup; filter with WHERE.
query I
SELECT (count(*) > 10)::INT FROM sch.products;
----
1

# SCHD (U.S. Dividend Equity ETF) is present with a non-negative expense ratio.
query I
SELECT (count(*) = 1)::INT FROM sch.products WHERE ticker = 'SCHD' AND expense_ratio_percent >= 0;
----
1

# Fund names are populated for the lineup (from each fund's product page).
query I
SELECT (count(*) >= 1)::INT FROM sch.products WHERE fund_name IS NOT NULL;
----
1

# ---- holdings ----

# Partition pushdown: WHERE fund_ticker = 'SCHD' fetches that fund's holdings, weight-descending.
query I
SELECT (count(*) > 20 AND max(weight_percent) > 0 AND bool_and(fund_ticker = 'SCHD'))::INT
FROM sch.holdings WHERE fund_ticker = 'SCHD';
----
1

# Multiple partitions at once: fund_ticker IN (...) fans out to two funds.
query I
SELECT (count(DISTINCT fund_ticker) = 2)::INT FROM sch.holdings WHERE fund_ticker IN ('SCHD', 'SCHF');
----
1

# An unfiltered scan is allowed — it streams EVERY fund's holdings (one partition per fund).
# LIMIT short-circuits the stream after the first partition, so this stays cheap.
query I
SELECT (count(*) >= 1)::INT FROM (SELECT * FROM sch.holdings LIMIT 5);
----
1

# The backing scan function also works directly (pushdown).
query I
SELECT (count(*) > 20)::INT FROM sch.holdings_scan() WHERE fund_ticker = 'SCHD';
----
1

# name: test/sql/holdings.test
# description: schwab.holdings base table — fund_ticker partition (pushdown), current holdings only.
# group: [sql]

require-env VGI_TEST_WORKER

statement ok
ATTACH 'schwab' AS sch (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SET search_path='sch.main';

# --- Schema: DESCRIBE binds only (no network). `holdings` is a base TABLE. ---

query T
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM sch.holdings WHERE fund_ticker = 'SCHD');
----
fund_ticker,as_of_date,weight_percent,ticker,name,cusip,quantity,market_value

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM sch.holdings WHERE fund_ticker = 'SCHD') WHERE column_name = 'as_of_date';
----
DATE

# --- Live invariants (hit Schwab through the impersonation transport). ---

# Partition pushdown: WHERE fund_ticker = 'SCHD' fetches that fund's holdings, weight-descending.
query I
SELECT (count(*) > 20 AND max(weight_percent) > 0 AND bool_and(fund_ticker = 'SCHD'))::INT
FROM sch.holdings WHERE fund_ticker = 'SCHD';
----
1

# Multiple partitions at once: fund_ticker IN (...) fans out to two funds.
query I
SELECT (count(DISTINCT fund_ticker) = 2)::INT FROM sch.holdings WHERE fund_ticker IN ('SCHD', 'SCHF');
----
1

# An unfiltered scan is allowed — it streams EVERY fund's holdings (one partition per fund).
# LIMIT short-circuits the stream after the first partition, so this stays cheap.
query I
SELECT (count(*) >= 1)::INT FROM (SELECT * FROM sch.holdings LIMIT 5);
----
1

# The backing scan function also works directly (pushdown).
query I
SELECT (count(*) > 20)::INT FROM sch.holdings_scan() WHERE fund_ticker = 'SCHD';
----
1
